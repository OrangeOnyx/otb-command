   "services": [
    "// Enforce rate limiting globally. Applies the ThrottlerModule config above // (plus any per-route @Throttle overrides) to every request. { provide: APP_GUARD, useClass: ThrottlerGuard }"
   ],
   "imports": [
    "// Config \u2014 global so all modules can inject ConfigService ConfigModule.forRoot({ isGlobal: true, envFilePath: ['.env.local', '.env'], // Fail fast at boot if a required secret/URL is missing. Relaxed under // NODE_ENV=test so the CI job (which only provides DB + admin JWT secrets) // and unit tests can boot without the full production secret set. validate: validateEnv, })",
    "// Global Prisma \u2014 single PrismaClient shared across every feature module. // Without this",
    "each feature module that lists PrismaService in its // providers spawns its own PrismaClient + connection pool",
    "which exhausts // Postgres at boot. PrismaModule",
    "// Rate limiting. A generous global default (per client IP) protects every // route from runaway traffic; sensitive endpoints (LLM chat, clause // abstraction, login) apply much tighter per-route @Throttle overrides. // The guard is wired globally via APP_GUARD below \u2014 without that provider // this config is inert (the Wave 49 gap this pass closes). ThrottlerModule.forRoot([ { ttl: 60_000, // 1 minute limit: 120, // 120 requests/min per IP \u2014 sane app-wide ceiling }, ])",
    "// Bull queue (Redis). // // Railway exposes Redis at an internal IPv6 host (redis.railway.internal)",
    "// so ioredis must use `family: 0` (allow IPv4+IPv6 DNS) or the connection // hangs forever. Critically",
    "every ioredis client MUST have an 'error' // listener attached: when a background connection attempt times out // (ETIMEDOUT) and the retryStrategy stops retrying",
    "ioredis emits an // 'error' event. Without a listener",
    "Node treats it as an unhandled // exception and crashes the process ~70s after a clean boot. Using a // `createClient` factory (instead of plain `redis` options) is the only // way to attach that listener to each underlying connection. BullModule.forRootAsync({ imports: [ConfigModule], inject: [ConfigService], useFactory: (config: ConfigService) => { const logger = new Logger('BullRedis'); // Prefer ConfigService, but fall back to process.env directly in case // the global ConfigModule hasn't populated this key by the time this // async factory is evaluated. Only then default to localhost. const url = config.get<string>('REDIS_URL') ?? process.env.REDIS_URL ?? 'redis://localhost:6379'; const parsed = new URL(url); // Log the resolved host (never the credentials) so deploy logs make it // obvious whether we connected to Railway's Redis or the localhost // fallback. logger.log(`Queue backend Redis host resolved to: ${parsed.hostname}:${parsed.port || 6379}`); const baseOptions: RedisOptions = { host: parsed.hostname, port: Number(parsed.port || 6379), username: parsed.username || undefined, password: parsed.password || undefined, // Allow both IPv4 and IPv6 lookups (required for *.railway.internal). family: 0, enableReadyCheck: false, connectTimeout: 10000, // Stop reconnecting after a handful of attempts so a Redis outage // can never wedge the app; the 'error' listener below swallows the // resulting error so the process stays alive. retryStrategy: (times: number) => (times > 5 ? null : Math.min(times * 200, 2000)), }; return { createClient: (type: 'client' | 'subscriber' | 'bclient', redisOpts?: RedisOptions): Redis => { // IMPORTANT ordering: spread Bull's per-type `redisOpts` FIRST, then // our connection settings, so OUR host/port/family always win. Bull // fills `redisOpts` with its own defaults (which point at // localhost:6379); if those were spread last they'd clobber the // Railway internal host and the client would connect to 127.0.0.1. // // Bull's blocking ('bclient') and pub/sub ('subscriber') connections // require `maxRetriesPerRequest: null` and offline queueing; only the // regular 'client' connection should fail commands fast. const options: RedisOptions = { ...redisOpts, ...baseOptions, ...(type === 'client' ? { maxRetriesPerRequest: 3, enableOfflineQueue: false } : { maxRetriesPerRequest: null, enableOfflineQueue: true }), }; logger.log( `Creating Redis ${type} client -> ${options.host}:${options.port} (family ${options.family})`, ); const client = new IORedis(options); // THE fix: handle connection errors so they never bubble up as an // unhandled exception and crash the Node process. client.on('error', (err: Error) => { logger.warn(`Redis ${type} connection error (non-fatal): ${err.message}`); }); return client; }, }; }, })",
