VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Default off for hosted builds. Enable only after the two physical-asset
# migrations and hosted role/storage tests pass, and bundled model/reference
# drawings, meter identifiers and photos are approved for public delivery.
# Local review (npm run dev:review) remains available without this flag.
VITE_ASSET_TWIN_ENABLED=0

# A-2 "Google 3D" lens (Google Photorealistic 3D Tiles, streamed at runtime).
# A BROWSER key — it ships in the bundle, so restrict it in Google Cloud:
#   API restriction: Map Tiles API only
#   Application restriction: HTTP referrers — the deployment hostnames (+ http://localhost:5199/* for dev)
# Never reuse the unrestricted server key from ~/.otb-gmaps.env here. Unset = the lens shows setup help.
VITE_GOOGLE_MAP_TILES_KEY=
