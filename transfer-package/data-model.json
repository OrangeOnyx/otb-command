{
  "system": "OTBC",
  "layers": {
    "A": "src/data/*.json — app runtime projection",
    "B": "docs/sot-2026-07/*.csv — governed source of truth (authority-ranked)",
    "C": "Supabase — live server state (JSONB layers + append-only tables + buckets)"
  },
  "entities": [
    { "id": "OTBC-ENTITY-001", "name": "Property", "file": "docs/sot-2026-07/properties.csv", "pk": "property_id", "rows": 1, "fields": ["property_id", "property_name", "ownership_entity", "property_type", "market", "primary_address", "total_rentable_sf", "source_of_truth_status", "notes"] },
    { "id": "OTBC-ENTITY-002", "name": "UnitApp", "file": "src/data/units.json", "pk": "unit", "rows": 27, "fields": ["unit", "dba", "legal", "use", "cat", "status", "base", "total", "monthly", "start", "end", "notes", "sf"], "enums": { "cat": ["retail", "food", "services", "financial", "medical", "office", "vacant"], "status": ["active", "vacant", "owner", "anchor"] }, "calculated": "monthly ~= total*sf/12 (2 pinned stated-rent exceptions)", "note": "monthly = TOTAL rent (operator convention); combined-lease rows are reporting allocations. units.public.json = redacted mirror (no legal/base/total/monthly/notes)" },
    { "id": "OTBC-ENTITY-003", "name": "UnitSOT", "file": "docs/sot-2026-07/units.csv", "pk": "unit_id", "rows": 27, "fks": { "property_id": "Property", "current_tenant_id": "Tenant", "current_lease_id": "Lease" }, "fields": ["unit_id", "property_id", "building_id", "unit_label", "rentable_sf", "current_status", "current_tenant_id", "current_lease_id", "lease_suite_group", "is_split_from_combined_lease", "allocation_percent_of_lease_group", "allocated_monthly_reporting_amount", "source_authority", "notes"], "note": "unit_label format '117 1/2' differs from app '117.5' — join needs normalizer" },
    { "id": "OTBC-ENTITY-004", "name": "Tenant", "file": "docs/sot-2026-07/tenants.csv", "pk": "tenant_id", "rows": 22, "fields": ["tenant_id", "display_name", "legal_entity", "dba", "status", "primary_contact_id", "billing_address", "source_authority"], "anomaly": "primary_contact_id is a dangling FK (contacts table not shipped)" },
    { "id": "OTBC-ENTITY-005", "name": "Lease", "file": "docs/sot-2026-07/leases.csv", "pk": "lease_id", "rows": 21, "authority": "rank 1 — economics/expiration/status", "fields": ["lease_id", "property_id", "tenant_id", "lease_suite_group", "lease_status", "rentable_sf", "base_psf", "cam_psf", "tax_psf", "insurance_psf", "total_psf", "monthly_rent_stated", "monthly_rent_formula_check", "monthly_variance", "expiration_date", "source_authority", "notes", "doorloop_dates_ignored"], "calculated": "total_psf = base+cam+tax+ins; formula_check = sf*total_psf/12; billing = stated" },
    { "id": "OTBC-ENTITY-006", "name": "LeaseUnit", "file": "docs/sot-2026-07/lease_units.csv", "pk": "lease_unit_id", "rows": 25, "fks": { "lease_id": "Lease", "unit_id": "UnitSOT" }, "keyRule": "allocation_is_legal_charge=false for combined groups (reporting only)" },
    { "id": "OTBC-ENTITY-007", "name": "RecurringCharge", "file": "docs/sot-2026-07/recurring_charges.csv", "pk": "charge_id", "rows": 105, "fks": { "lease_id": "Lease" }, "enums": { "charge_type": ["base_rent", "cam", "tax_reimbursement", "insurance_reimbursement", "total_monthly_authoritative"], "amount_type": ["annual_psf", "monthly_stated"] }, "note": "5 rows per lease; total_monthly_authoritative row is the billing figure" },
    { "id": "OTBC-ENTITY-008", "name": "LeaseClause", "file": "docs/sot-2026-07/lease_clauses.csv", "pk": "lease_clause_id", "rows": 21, "fields": ["use_clause", "exclusive_or_prohibited_uses", "insurance_requirement", "late_fee_terms", "payment_method", "hvac_split", "maintenance_repairs"], "anomaly": "literal 'true' strings as missing-value artifacts; blank HVAC templates" },
    { "id": "OTBC-ENTITY-009", "name": "Recoveries", "file": "src/data/recoveries.json", "keyedBy": "unit", "fields": ["base", "cam", "tax", "ins", "total"], "top": { "camFlatPsf": 2.1 }, "invariant": "base+cam+tax+ins == total; single source for CAM/Tax/Ins" },
    { "id": "OTBC-ENTITY-010", "name": "ComplianceSchema", "file": "src/data/compliance.json", "fields11": ["coi", "lic", "hvac", "grease", "ansul", "dep", "w9", "walk", "sign", "lease", "ach"], "foodOnly": ["grease", "ansul"], "states": ["u", "ok", "flag", "na"], "note": "cell states live in store 'comp' layer" },
    { "id": "OTBC-ENTITY-011", "name": "Vendor", "file": "src/data/vendors.json + public.vendors", "pk": "id (slug)", "rows": 70, "fields": ["id", "company", "contact", "email", "phone", "city", "notes", "kind"], "enums": { "kind": ["service", "payee", "person"] }, "serverExtra": ["active", "coi_expires", "coi_note"] },
    { "id": "OTBC-ENTITY-012", "name": "Directory", "file": "src/data/directory.json", "collections": { "propertyContacts": "pc:* (7)", "propertyDocuments": "pd:* (~20, type enum)", "unitDocTypes": "6 controlled strings" } },
    { "id": "OTBC-ENTITY-013", "name": "HvacSplit", "file": "src/data/hvac.json", "keyedBy": "unit", "fields": ["repair", "replace", "tier"], "enums": { "tier": ["standard", "pct", "full"] }, "anomaly": "money as formatted strings ('$1,500', '50%')" },
    { "id": "OTBC-ENTITY-014", "name": "Geometry", "file": "src/data/geometry.json", "rev": "REV 12", "keys": ["demising (2 buildings, bays+provenance)", "liquorLine", "parking (9 zones, totalPlat 314, variance {99-11797, 324/344})", "streets", "easements", "boundary (main + Lot 7 Block M)", "layers (SVG primitives)", "units (plan-px rects)", "viewBox"] },
    { "id": "OTBC-ENTITY-015", "name": "SpatialCluster", "files": ["heights.json (unit->ft)", "footprints-geo.json (27 GeoJSON polygons + georef affine)", "sat-base.json (frozen Esri corners)", "splat-align.json (quat/scale/pos + fit meta)"] },
    { "id": "OTBC-ENTITY-016", "name": "Camera", "file": "src/data/cameras.json", "rows": 17, "fields": ["id", "name", "ip", "dwViewId", "suite", "pos{x,y}", "aimDeg", "fovDeg", "rangePx", "zone", "posConfidence"], "plus": "excluded[] (4 off-property), cloud metadata" },
    { "id": "OTBC-ENTITY-017", "name": "OccupancyCluster", "files": ["docs/c3-stall-zones.json (per-cam stall quads, native px)", "src/data/stall-map.json (stall -> {rank,index,ada?}, ranks: row56|lot8|field-149|aisle-101|north-edge)", "supabase occupancy_samples (append-only, PK frame+stall)"] },
    { "id": "OTBC-ENTITY-018", "name": "LinkRegistries", "files": ["lease-links.json (25)", "logo-links.json (24)", "logo-thumbs.json (25, generated)", "floorplan-links.json (27)", "contacts-info.json (25, email coverage ~16%)"], "note": "confidential registries ride in api/_seed.json, not the public bundle" },
    { "id": "OTBC-ENTITY-019", "name": "PersistedLayers", "registry": "src/lib/layers.js", "layers": { "comp": "unit.field -> u|ok|flag|na", "notes": "unit -> string", "actions": "{lane, edit, dismissed, custom[]}", "contacts": "{edit, dismissed, custom[]}", "documents": "{edit, dismissed, custom[]}", "financials": "{opex{taxes,insurance,cam,mgmt,utilities,reserves}, capRatePct}", "ownerSheets": "pageId[]", "features": "pin[] {x,y,...}", "cameras": "camId -> {x,y,aimDeg}" }, "storage": "localStorage otb-command-state-v1 + Supabase property_state (one JSONB row per layer)" },
    { "id": "OTBC-ENTITY-020", "name": "ServerTables", "source": "supabase/security-model.sql", "tables": ["profiles(id,email,role)", "authorized_emails", "property_state(property_id,layer,data,updated_at)", "vendors(+coi)", "vendor_log", "safe_log", "chat_threads(+trigger_source unique)", "chat_messages", "api_usage(email,kind,day,n)", "app_secrets(deny-all)", "owner_briefs(month,html,model)", "compliance_events(append-only)", "ledger_entries(append-only, deterministic ids, void_of)", "occupancy_samples(PK frame,stall)"], "buckets": ["assets", "documents", "safe", "vendor-docs"] },
    { "id": "OTBC-ENTITY-021", "name": "Governance", "files": ["source_authorities.csv (rank 1 signed rent roll > 2 all-units > 3 abstracts > 99 DoorLoop-never)", "validation_rules.csv (5 rules; blocking: sf_total=62810, doorloop-never)", "known_exceptions.csv (2 accepted variances; behavior: store both, bill stated)"] }
  ],
  "relationshipMap": "Property -> UnitSOT -> {Tenant, Lease -> {LeaseUnit, RecurringCharge, LeaseClause}}; unit key joins all Layer-A files; Camera -> stall-zones -> stall-map -> Geometry.parking",
  "anomalies": [
    "Headline RSF conflict: 62,883 audited GLA vs 62,810 demised sum (labeled convention)",
    "Unit-label format drift (117 1/2 vs 117.5 vs 135A)",
    "Combined-lease allocations look billable in units.json; guard flag only in CSV layer",
    "Money-as-string in hvac.json; 'true' artifacts in lease_clauses.csv",
    "Dangling tenants.primary_contact_id FK",
    "Vendor casing/typos; probable Investar/Investart duplicate",
    "Deposits missing 107/137/143/149; parking delta -10 unreconciled; contacts email ~16%"
  ],
  "missingEntities": ["WorkOrder", "Invoice", "PurchaseOrder", "Inspection", "Incident", "Budget", "CamReconciliation", "SecurityDeposit ledger", "TenantInsurancePolicy", "Amendment (first-class)"]
}
